# LF em todos os arquivos texto.
* text=auto eol=lf

# Binarios -- nao converter EOL.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.pdf      binary
*.xlsx     binary
*.xls      binary
*.docx     binary
*.doc      binary
*.pptx     binary
*.ppt      binary
*.zip      binary
*.rar      binary
*.7z       binary
*.tar.gz   binary
*.tgz      binary
*.gz       binary
*.bin      binary
*.elf      binary
*.hex      binary

# Scripts Windows: CRLF.
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
