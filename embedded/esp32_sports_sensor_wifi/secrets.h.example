// Template de credenciais do sketch ESP32. Copie para `secrets.h` (mesma
// pasta) e edite. O arquivo final esta listado em .gitignore -- a opcao
// pelo header com #define em vez de .env eh por compatibilidade com o
// toolchain do Arduino, que nao carrega variaveis de ambiente.

#pragma once

// --- Wi-Fi ------------------------------------------------------------------
#define WIFI_SSID        "MUDE_AQUI_SSID"
#define WIFI_PASSWORD    "MUDE_AQUI_SENHA"

// --- Identidade do dispositivo ----------------------------------------------
// DEVICE_ID compoe o clientId MQTT e aparece em todo registro de medida;
// se rodar a campanha com mais de um ESP32, manter ids diferentes para
// permitir analise por dispositivo.
#define DEVICE_ID        "esp32-01"

// --- Endpoints HTTP ---------------------------------------------------------
//
// String vazia desabilita o transporte (o sketch pula no failover).
// Use o IP LAN do PC; "localhost"/"127.0.0.1" referencia o proprio ESP32.
//
// BACKEND_HTTP_BASE eh a mesma origem do BACKEND_URL sem o /ingest/sensor;
// o sketch consulta `<base>/config` para puxar o intervalMs do
// orquestrador entre cenarios da campanha.
#define BACKEND_URL          "http://192.168.0.10:3000/ingest/sensor"
#define BACKEND_HTTP_BASE    "http://192.168.0.10:3000"

// Serverless (A3) -- complementar no estudo. Local: vercel dev em :3001.
// Producao: deployment Vercel. Deixar vazio se nao houver deploy ativo.
#define SERVERLESS_URL       ""
#define SERVERLESS_HTTP_BASE ""

// X-Api-Key opcional (vazio omite o header).
#define API_KEY           ""

// --- MQTT (A4) --------------------------------------------------------------
//
// O MQTT_QOS eh fixo em 0 porque o PubSubClient nao implementa QoS 1/2;
// elevar isso exigiria trocar a biblioteca, o que mudaria o overhead de
// processamento no ESP32 e tornaria a comparacao com A1/A2 desigual.
#define MQTT_HOST              "192.168.0.10"
#define MQTT_PORT              1883
#define MQTT_USER              ""
#define MQTT_PASS              ""
#define MQTT_TOPIC_TEMPLATE    "iot/{deviceId}/sensor"
#define MQTT_QOS               0

// A bridge MQTT (arquitetura-mqtt/bridge) expoe um shim HTTP em :4002
// com as mesmas rotas do backend Node, inclusive /config. Isso permite
// usar o mesmo mecanismo de polling de intervalMs quando o transporte
// ativo eh MQTT.
#define MQTT_BRIDGE_HTTP_BASE  "http://192.168.0.10:4002"

// --- Tuning -----------------------------------------------------------------

// Frequencia inicial. Em campanha eh sobrescrita pelo polling de /config,
// entao esse valor so vale antes da primeira sincronizacao com o backend.
#define DEFAULT_SEND_INTERVAL_MS  100UL

// 2 s eh um compromisso entre responsividade na transicao de cenarios e
// overhead (~1 GET extra por 2 s nao distorce a comparacao). Reduzir a
// 1 s ou menos passaria a competir com a frequencia de envio em rajadas.
#define CONFIG_POLL_INTERVAL_MS   2000UL

#define SNTP_SERVER      "pool.ntp.org"

// Timeout curto e proposital: a politica do sketch eh perder amostra em
// vez de empilhar fila no Wi-Fi. Isso aparece nas metricas como
// missing_messages e nao como aumento espurio de latencia. Ver Discussao.
#define HTTP_TIMEOUT_MS  200

// Probe so precisa decidir vivo/morto, entao basta uma janela maior que
// o RTT esperado em LAN -- nao a do envio normal.
#define PROBE_TIMEOUT_MS 600

// Mais alto que o de envio porque WPA2 + DHCP costumam ter cauda longa.
// O loop continua tentando reconectar mesmo apos o timeout estourar.
#define WIFI_CONNECT_TIMEOUT_MS  20000UL
