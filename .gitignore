*.hex
*.elf
*.bin
arduino/**/build/

# secrets.h carrega SSID, senha do Wi-Fi e credenciais MQTT do ESP32.
# Versionamos apenas o secrets.h.example como template; cada operador
# copia e edita a sua copia local.
embedded/**/secrets.h

.vscode/
.idea/
*.iml
*.swp
*.swo
*~

Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

