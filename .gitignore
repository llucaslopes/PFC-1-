# Dependências
node_modules/

# Variáveis de ambiente
.env
.env.*
!.env.example

# Build / saída
dist/
build/
*.tsbuildinfo
coverage/
.cache/

# Saídas de experimentos (geradas pelos scripts)
logs/
*.log

# Resultados de experimentos: versionar apenas READMEs e gráficos.
# Ignora todo o conteúdo dentro de resultados/ e subpastas
# (CSVs, JSONs, etc.), mas mantém a estrutura de pastas,
# READMEs e imagens em qualquer nível de profundidade.
# Obs.: arquivos .rar/.zip na raiz do projeto (ex.: resultados.rar)
# continuam versionados para envio ao orientador.
resultados/**
!resultados/
!resultados/**/
!resultados/**/README.md
!resultados/**/README*.md
!resultados/**/*.png
!resultados/**/*.jpg
!resultados/**/*.jpeg
!resultados/**/*.svg
!resultados/**/*.gif
!resultados/**/*.webp
!resultados/**/*.pdf

# Entregáveis do TCC (figuras, tabelas, diagramas e textos academicos)
# em resultados/figuras_tcc/. Aqui versionamos TUDO, inclusive .csv,
# .xlsx, .md e .mmd, porque sao os artefatos finais do trabalho.
!resultados/figuras_tcc/**/*.md
!resultados/figuras_tcc/**/*.mmd
!resultados/figuras_tcc/**/*.csv
!resultados/figuras_tcc/**/*.xlsx

# Consolidados das campanhas (sao a entrada dos scripts de plotagem
# e tabelas; sem eles o repo nao regenera as figuras do TCC).
!resultados/**/consolidated_metrics.csv
!resultados/**/consolidated_metrics.json
!resultados/**/consolidated_metrics_corrected.csv
!resultados/**/consolidated_metrics_corrected.json

# Audit trail das correcoes (rollover micros() do Arduino, etc.).
!resultados/**/correction_report.json

# Resumos finais utilizados pelo artigo (graficos-artigo/*.csv).
# Os PNGs ja sao versionados; aqui liberamos as fontes de dados.
!resultados/graficos-artigo/*.csv

# Python (scripts/consolidate_results.py, plot_results.py)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Playwright
playwright-report/
test-results/
blob-report/
.playwright/

# Arduino (compilação local)
*.hex
*.elf
*.bin
arduino/**/build/

# IDE / editores
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# Sistema operacional
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Perfil persistente do Chromium usado pelo Playwright (WebSerial)
.playwright-profile/

# Lixo de merge / backups de editor
*.bak
*.orig
*.rej

# Caches de gerenciadores de pacote
.npm/
.yarn/
.pnpm-store/
.pnp.*