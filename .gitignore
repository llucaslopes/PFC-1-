node_modules/

.env
.env.*
!.env.example

dist/
build/
*.tsbuildinfo
coverage/
.cache/

logs/
*.log

# Saidas brutas das campanhas. A regra eh inversa: ignoramos todos os
# arquivos dentro de resultados/, mas readmitimos o que tem valor de
# documentacao no relatorio (Markdowns, figuras, PDFs). CSV/JSON ficam
# de fora porque crescem rapido e podem ser regenerados a partir das
# campanhas; quando precisamos enviar dados ao orientador, geramos um
# .rar/.zip na raiz, que continua versionado.
resultados/**
!resultados/
!resultados/**/
!resultados/**/*.md
!resultados/**/*.png
!resultados/**/*.jpg
!resultados/**/*.jpeg
!resultados/**/*.svg
!resultados/**/*.gif
!resultados/**/*.webp
!resultados/**/*.pdf

# Pacote final de entrega do TCC: figuras, tabelas e diagramas. Aqui
# versionamos tambem .csv/.xlsx/.mmd porque sao os artefatos canonicos
# que viram anexo do relatorio.
!resultados/figuras_tcc/**/*.mmd
!resultados/figuras_tcc/**/*.csv
!resultados/figuras_tcc/**/*.xlsx
_legacy_resultados

# Consolidados sao a entrada dos scripts de plotagem -- sem eles o
# repo nao regenera as figuras do TCC a partir de um clone limpo.
!resultados/**/consolidated_metrics.csv
!resultados/**/consolidated_metrics.json
!resultados/**/consolidated_metrics_corrected.csv
!resultados/**/consolidated_metrics_corrected.json

# Trilha de auditoria das correcoes pos-coleta (ex.: rollover do micros
# no firmware antigo). Pequeno e necessario para reproduzir o ajuste.
!resultados/**/correction_report.json

# Fontes de dados das figuras embutidas no artigo. Os PNGs ja entram
# pela whitelist global; aqui liberamos os CSVs que os geram.
!resultados/graficos-artigo/*.csv

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

playwright-report/
test-results/
blob-report/
