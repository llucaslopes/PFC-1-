PORT=3000

# Fontes oficiais do backend Node (A1 + A2):
#   wifi-http (default): aguarda POST /ingest/sensor do ESP32 via Wi-Fi.
#   simulator:           gera amostras sinteticas no backend (sanity-check; nao vale como dado do TCC).
#   serial:              fonte LEGADO (USB serial); preserva campanhas antigas.
SENSOR_SOURCE=wifi-http

# Hardening minimo: se setado, /ingest/sensor exige header X-Api-Key=...
API_KEY=

# Apenas para SENSOR_SOURCE=simulator
SIMULATOR_INTERVAL_MS=100

# Apenas para SENSOR_SOURCE=serial (legado)
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=115200
