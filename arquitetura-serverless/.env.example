# Variaveis de ambiente da arquitetura serverless (A3).
# Em producao, configure no dashboard da Vercel; em dev local, salve em .env.local.

# Vercel KV (gerados ao criar o store no dashboard)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Hardening minimo (opcional). Se setada, /api/ingest e demais POSTs exigem
# header X-Api-Key igual a este valor.
INGEST_API_KEY=
