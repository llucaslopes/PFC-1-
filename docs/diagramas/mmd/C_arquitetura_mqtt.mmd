%% Diagrama C - Arquitetura MQTT / Pub-Sub (interno A4)
%% O ESP32 publica em um tópico; quem quiser receber assina o tópico.
flowchart LR
    classDef device  fill:#FFE2B8,stroke:#CC7A1F,stroke-width:2px,color:#222
    classDef broker  fill:#F2D5F2,stroke:#8E3A8E,stroke-width:2px,color:#222
    classDef bridge  fill:#CFE5FF,stroke:#2F6BBF,stroke-width:2px,color:#222
    classDef client  fill:#D4F0CF,stroke:#357A2E,stroke-width:2px,color:#222

    ESP["<b>ESP32</b><br/>publisher"]:::device
    BR[["<b>Broker MQTT</b><br/>Mosquitto<br/>tópico: iot/&lt;id&gt;/sensor"]]:::broker
    BG["<b>Bridge Node</b><br/>subscriber → WebSocket"]:::bridge
    NA["<b>Navegador</b><br/>(dashboard)"]:::client

    ESP -- "PUBLISH (Wi-Fi)" --> BR
    BR -- "SUBSCRIBE" --> BG
    BG == "broadcast WebSocket" ==> NA
